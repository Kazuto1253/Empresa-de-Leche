# Copy this file to an ignored external file and set ECOLACTEA_CONFIG_FILE to its path.
# Never commit real credentials.
DB_URL=jdbc:mysql://127.0.0.1:3306/<database_name>
DB_USER=<application_user>
DB_PASSWORD=<external_secret>
DB_POOL_SIZE=10
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
DEV_SEED_PASSWORD=
