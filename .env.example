# Copy values to the ignored secrets.properties; use literal KEY=value, without quotes.
# Launch with ECOLACTEA_CONFIG_FILE pointing to that file. Environment overrides file values.
DB_URL=jdbc:mysql://localhost:3306/ecolactea
DB_USER=
DB_PASSWORD=
DB_POOL_SIZE=10
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
AUTH_BOOTSTRAP_ENABLED=false
AUTH_BOOTSTRAP_USERNAME=
AUTH_BOOTSTRAP_PASSWORD=
# Absolute path to app/webApp/build/dist/composeWebCompatibility/productionExecutable
WEB_ROOT=
